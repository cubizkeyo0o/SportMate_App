<?xml version="1.0" encoding="utf-8"?>
<!--
    Main flow after sign-in; reachable only through MainActivity once the session is authenticated.
    Bookings and play request destinations are added here as those features are built.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.sportmate.app.presentation.home.HomeFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_home_to_profile"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_home_to_courts"
            app:destination="@id/courtsFragment" />
        <action
            android:id="@+id/action_home_to_my_bookings"
            app:destination="@id/myBookingsFragment" />
        <action
            android:id="@+id/action_home_to_play_requests"
            app:destination="@id/playRequestsFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.sportmate.app.presentation.profile.ProfileFragment"
        android:label="@string/profile_title" />

    <fragment
        android:id="@+id/courtsFragment"
        android:name="com.sportmate.app.presentation.courts.CourtsFragment"
        android:label="@string/courts_title">
        <action
            android:id="@+id/action_courts_to_court_detail"
            app:destination="@id/courtDetailFragment" />
    </fragment>

    <!-- Loads the court itself from its id; the court object is not passed along. -->
    <fragment
        android:id="@+id/courtDetailFragment"
        android:name="com.sportmate.app.presentation.courts.CourtDetailFragment"
        android:label="@string/court_detail_title">
        <argument
            android:name="courtId"
            app:argType="string" />
        <action
            android:id="@+id/action_court_detail_to_book_court"
            app:destination="@id/bookCourtFragment" />
    </fragment>

    <!-- Booking. Screens receive ids and court-local values only; each loads its own data. -->
    <fragment
        android:id="@+id/bookCourtFragment"
        android:name="com.sportmate.app.presentation.booking.BookCourtFragment"
        android:label="@string/book_court_title">
        <argument
            android:name="courtId"
            app:argType="string" />
        <action
            android:id="@+id/action_book_court_to_summary"
            app:destination="@id/bookingSummaryFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookingSummaryFragment"
        android:name="com.sportmate.app.presentation.booking.BookingSummaryFragment"
        android:label="@string/booking_summary_title">
        <argument
            android:name="courtId"
            app:argType="string" />
        <argument
            android:name="courtSportId"
            app:argType="string" />
        <argument
            android:name="date"
            app:argType="string" />
        <argument
            android:name="startTime"
            app:argType="string" />
        <argument
            android:name="endTime"
            app:argType="string" />
        <!-- The summary and time selection are removed once the booking exists, so Back cannot
             lead to creating it again. Back from the booking returns to the court. -->
        <action
            android:id="@+id/action_summary_to_booking_detail"
            app:destination="@id/bookingDetailFragment"
            app:popUpTo="@id/courtDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookingDetailFragment"
        android:name="com.sportmate.app.presentation.booking.BookingDetailFragment"
        android:label="@string/booking_detail_title">
        <argument
            android:name="bookingId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/myBookingsFragment"
        android:name="com.sportmate.app.presentation.booking.MyBookingsFragment"
        android:label="@string/my_bookings_title">
        <action
            android:id="@+id/action_my_bookings_to_booking_detail"
            app:destination="@id/bookingDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/playRequestsFragment"
        android:name="com.sportmate.app.presentation.playrequest.PlayRequestsFragment"
        android:label="@string/play_requests_title">
        <action
            android:id="@+id/action_play_requests_to_detail"
            app:destination="@id/playRequestDetailFragment" />
        <action
            android:id="@+id/action_play_requests_to_create"
            app:destination="@id/createPlayRequestFragment" />
    </fragment>

    <fragment
        android:id="@+id/playRequestDetailFragment"
        android:name="com.sportmate.app.presentation.playrequest.PlayRequestDetailFragment"
        android:label="@string/play_detail_title">
        <argument
            android:name="playRequestId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/createPlayRequestFragment"
        android:name="com.sportmate.app.presentation.playrequest.CreatePlayRequestFragment"
        android:label="@string/play_create_title" />
</navigation>
