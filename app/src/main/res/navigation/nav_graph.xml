<?xml version="1.0" encoding="utf-8"?>
<!--
    Root graph: Splash routes to the auth flow or the main flow. The global actions clear the back
    stack, so Back never returns to Splash or from main into auth (or vice versa).
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.sportmate.app.presentation.splash.SplashFragment"
        android:label="@string/app_name" />

    <include app:graph="@navigation/auth_nav_graph" />

    <include app:graph="@navigation/main_nav_graph" />

    <action
        android:id="@+id/action_global_auth"
        app:destination="@id/auth_nav_graph"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <action
        android:id="@+id/action_global_main"
        app:destination="@id/main_nav_graph"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />
</navigation>
