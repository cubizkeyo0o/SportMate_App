<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_navigate_up"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/booking_detail_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/error_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding"
            android:visibility="gone">

            <TextView
                android:id="@+id/error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.SportMate.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retry_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/action_retry" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingBottom="@dimen/screen_padding">

                <TextView
                    android:id="@+id/status_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SportMate.Title" />

                <!-- Mock payment while Pending -->
                <LinearLayout
                    android:id="@+id/pay_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/hold_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/hold_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:textAppearance="@style/TextAppearance.SportMate.Body" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/booking_mock_payment_note"
                        android:textAppearance="@style/TextAppearance.SportMate.Label" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pay_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="@string/booking_pay" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/action_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    style="@style/Widget.SportMate.FieldLabel"
                    android:text="@string/booking_label_court" />

                <TextView
                    android:id="@+id/court_value"
                    style="@style/Widget.SportMate.FieldValue" />

                <TextView
                    style="@style/Widget.SportMate.FieldLabel"
                    android:text="@string/booking_label_sport" />

                <TextView
                    android:id="@+id/sport_value"
                    style="@style/Widget.SportMate.FieldValue" />

                <TextView
                    style="@style/Widget.SportMate.FieldLabel"
                    android:text="@string/booking_label_date" />

                <TextView
                    android:id="@+id/date_value"
                    style="@style/Widget.SportMate.FieldValue" />

                <TextView
                    style="@style/Widget.SportMate.FieldLabel"
                    android:text="@string/booking_label_time" />

                <TextView
                    android:id="@+id/time_value"
                    style="@style/Widget.SportMate.FieldValue" />

                <TextView
                    style="@style/Widget.SportMate.FieldLabel"
                    android:text="@string/booking_label_time_zone" />

                <TextView
                    android:id="@+id/time_zone_value"
                    style="@style/Widget.SportMate.FieldValue" />

                <TextView
                    style="@style/Widget.SportMate.FieldLabel"
                    android:text="@string/booking_label_total" />

                <TextView
                    android:id="@+id/price_value"
                    style="@style/Widget.SportMate.FieldValue" />

                <TextView
                    style="@style/Widget.SportMate.FieldLabel"
                    android:text="@string/booking_label_booked_at" />

                <TextView
                    android:id="@+id/booked_at_value"
                    style="@style/Widget.SportMate.FieldValue" />

                <LinearLayout
                    android:id="@+id/cancellation_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Widget.SportMate.FieldLabel"
                        android:text="@string/booking_label_cancelled_at" />

                    <TextView
                        android:id="@+id/cancelled_at_value"
                        style="@style/Widget.SportMate.FieldValue" />

                    <TextView
                        android:id="@+id/cancellation_reason_value"
                        style="@style/Widget.SportMate.FieldValue" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.SportMate.FieldLabel"
                    android:text="@string/booking_label_reference" />

                <TextView
                    android:id="@+id/reference_value"
                    style="@style/Widget.SportMate.FieldValue"
                    android:textIsSelectable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancel_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:text="@string/booking_cancel"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
